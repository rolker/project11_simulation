<?xml version="1.0"?>
<package format="2">
  <name>marine_charts_to_gazebo_world</name>
  <version>0.0.0</version>
  <description>Generate Gazebo Harmonic SDF worlds from S57 ENC chart data</description>

  <maintainer email="roland@ccom.unh.edu">Roland Arsenault</maintainer>

  <license>Apache-2.0</license>

  <depend>python3-gdal</depend>
  <depend>python3-numpy</depend>
  <depend>python3-scipy</depend>
  <depend>python3-requests</depend>
  <depend>python3-pil</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
