<?xml version="1.0"?>
<package format="3">
  <name>portsmouth_nh_gazebo</name>
  <version>0.0.0</version>
  <description>Gazebo Harmonic world for Portsmouth NH harbor area</description>

  <maintainer email="roland@ccom.unh.edu">Roland Arsenault</maintainer>

  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- World generation at build time -->
  <build_depend>marine_charts_to_gazebo_world</build_depend>
  <build_depend>python3-yaml</build_depend>

  <!-- Launch-time dependencies -->
  <exec_depend>marine_charts_to_gazebo_world</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
